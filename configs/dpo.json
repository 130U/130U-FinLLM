{
  "mode": "formal",
  "stage": "dpo",
  "model": {
    "vocab_size": 8192,
    "hidden_size": 512,
    "num_hidden_layers": 6,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "intermediate_size": 1664,
    "max_position_embeddings": 512,
    "rms_norm_eps": 1e-06,
    "rope_theta": 1000000.0,
    "dropout": 0.0,
    "qk_norm": true,
    "tie_word_embeddings": true
  },
  "tokenizer": "tokenizer/english",
  "data": "data/task/preferences_train.jsonl",
  "validation_data": "data/task/development.jsonl",
  "output_dir": "runs/dpo",
  "train": {
    "device": "auto",
    "seed": 130,
    "batch_size": 1,
    "grad_accumulation": 8,
    "seq_len": 512,
    "max_updates": 500,
    "max_tokens": null,
    "schedule_updates": 250,
    "learning_rate": 3e-06,
    "min_lr_ratio": 0.1,
    "warmup_updates": 5,
    "weight_decay": 0.1,
    "clip_grad": 1.0,
    "save_every": 50,
    "validation_every": 50,
    "validation_max_batches": null,
    "amp": true,
    "num_workers": 0,
    "max_epochs": 1,
    "beta": 0.1
  },
  "init_checkpoint": "runs/sft/best.pt",
  "reference_checkpoint": "runs/sft/best.pt"
}
